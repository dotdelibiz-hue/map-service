rules_version = '2';

// REKITABI の Firestore セキュリティルール
// - プロフィール・訪問記録・探訪記は誰でも閲覧できます（性別・生年月日などは users/{uid}/private に分けて本人のみ）
// - 書き込みは本人のみ。探訪記の投稿と訪問記録はメールアドレス認証済みのユーザーのみ
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function validProfile(d) {
      return d.name is string && d.name.size() <= 30
        && d.userName is string && d.userName.size() <= 20
        && (d.userName == '' || d.userName.matches('^[A-Za-z0-9_]+$'))
        && d.bio is string && d.bio.size() <= 30
        && d.photoURL is string && d.photoURL.size() <= 2048;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(['name', 'userName', 'bio', 'photoURL', 'createdAt'])
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'userName', 'bio', 'photoURL'])
        && validProfile(request.resource.data);
      allow delete: if false;

      // 本人だけが読み書きできる情報（メールアドレス・性別・生年月日・居住地）
      match /private/{docId} {
        allow read, write: if isUser(uid);
      }

      // 訪問記録（ドキュメント ID = 史跡 ID）
      match /visits/{siteId} {
        allow read: if true;
        allow create: if isUser(uid) && verified()
          && request.resource.data.keys().hasOnly(['visitedAt'])
          && request.resource.data.visitedAt == request.time;
        allow update, delete: if false;
      }
    }

    match /moments/{momentId} {
      function validMoment(d) {
        return d.userId == request.auth.uid
          && d.title is string && d.title.size() > 0 && d.title.size() <= 45
          && d.text is string && d.text.size() > 0 && d.text.size() <= 5000
          && d.eraTags is list && d.eraTags.size() <= 20
          && d.photoURLs is list && d.photoURLs.size() <= 5
          && d.thumbnailURL is string && d.thumbnailURL.size() <= 2048
          && d.siteId is string && d.siteId.size() <= 100
          && d.logicalDeleteFlag == false;
      }
      allow get: if resource.data.logicalDeleteFlag == false || isUser(resource.data.userId);
      allow list: if resource.data.logicalDeleteFlag == false;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['userId', 'title', 'text', 'eraTags', 'photoURLs', 'thumbnailURL', 'siteId', 'logicalDeleteFlag', 'createdAt', 'updatedAt'])
        && validMoment(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // 削除は論理削除（logicalDeleteFlag を true にする）のみ
      allow update: if isUser(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logicalDeleteFlag', 'updatedAt'])
        && request.resource.data.logicalDeleteFlag == true
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
