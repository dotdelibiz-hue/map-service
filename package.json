{
  "name": "map-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "全国の史跡を地図と音声ガイドでめぐる Web サービス",
  "scripts": {
    "predev": "node scripts/build-seed.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-seed.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "build:seed": "node scripts/build-seed.mjs",
    "dev:emulator": "vite --mode emulator",
    "emulators": "npx -y firebase-tools@15 emulators:start --project demo-rekitabi --only auth,firestore,storage",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --project demo-rekitabi-rules --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "deploy": "npx -y firebase-tools@15 deploy"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.4",
    "firebase": "^13.0.0",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^27.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
