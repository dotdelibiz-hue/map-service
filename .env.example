# Firebase の設定（Firebase コンソール → プロジェクトの設定 → マイアプリ で確認できます）
# 設定しない場合は、データをブラウザ内に保存する「デモモード」で動きます。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# ローカルの Firebase エミュレーターにつなぐ場合は true
VITE_FIREBASE_USE_EMULATOR=false

# 運営者名・お問い合わせ先（プライバシーポリシーやメニューに表示されます）
VITE_OPERATOR_NAME=
VITE_CONTACT_URL=mailto:contact@example.com
VITE_HELP_URL=

# 現地判定の距離（メートル）
VITE_NEARBY_RADIUS_M=500
